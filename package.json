{
  "name": "sapere-desktop",
  "private": true,
  "author": "Erfan817",
  "contributors": ["Reviva upstream contributors"],
  "license": "AGPL-3.0",
  "description": "Sapere 致知：围绕你的资料，支持学习、写作与创作的本地优先 AI 工作台。",
  "version": "1.5.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.16.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder",
    "build:all": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --win --mac",
    "build:mac": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --mac",
    "build:linux": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "preview": "vite preview",
    "migrate-db": "node scripts/migrate-db.js",
    "postinstall": "electron-builder install-app-deps",
    "build:electron": "cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "test:wiki": "node --test electron/wiki/__tests__/wiki-core.test.js",
    "test:skills": "node --test electron/SkillService.test.js",
    "test:k12-agents": "node scripts/verify-k12-learning-agents.mjs",
    "test:themes": "node --test src/styles/themes/themes.test.js",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron --test electron/atomicFile.test.js electron/DatabaseService.contract.test.js electron/DatabaseService.integration.test.js electron/SkillService.test.js electron/SecretStorage.test.js electron/learning-memory/LearningMemoryRepository.test.js electron/learning-memory/LearningMemoryHardening.test.js electron/db/repositories/QuickInputRepository.test.js electron/tools/note/NoteTool.test.js electron/agents/TitleGenerator.test.js electron/agents/runtime/toolSelection.test.js electron/agents/runtime/builtinContentToolBindings.test.js electron/tools/pdf/PdfOcrService.test.js electron/SettingsTransferService.test.js"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": []
    },
    "onlyBuiltDependencies": [
      "electron",
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "@langchain/anthropic": "^1.3.29",
    "@langchain/core": "^1.2.13",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.4.5",
    "@langchain/tavily": "^1.2.0",
    "@openilink/openilink-sdk-node": "^0.6.0",
    "@tanstack/vue-virtual": "^3.13.30",
    "better-sqlite3": "^12.9.0",
    "deepagents": "^1.10.2",
    "electron-updater": "^6.8.3",
    "jsonrepair": "^3.15.0",
    "jszip": "^3.10.1",
    "langchain": "^1.5.14",
    "langsmith": "~0.6.3",
    "markdown-docx": "^1.7.0",
    "mathjs": "^15.2.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.13.0",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antv/g6": "^5.1.1",
    "@electron/rebuild": "^4.0.4",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.16.1",
    "cross-env": "^10.1.0",
    "electron": "30.5.1",
    "electron-builder": "^24.13.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "markdown-it": "^14.2.0",
    "markstream-vue": "1.0.1-beta.1",
    "mermaid": "^11.15.0",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "playwright-core": "1.65.0",
    "remixicon": "^4.9.1",
    "sass": "^1.97.3",
    "simple-mind-map": "0.14.0-fix.2",
    "sql.js": "^1.14.1",
    "stream-markdown": "^0.0.15",
    "typescript": "^5.2.2",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js"
}
